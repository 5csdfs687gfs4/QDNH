{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cuentas opcionales QDNH",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "Operators"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "Operators": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["UserId", "Callsign", "Role", "SecretEnvironmentVariable"],
        "properties": {
          "UserId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,48}$" },
          "Callsign": { "type": "string", "pattern": "^[a-zA-Z0-9/ -]{1,24}$" },
          "Role": { "enum": ["Observer", "Operator", "Administrator"] },
          "SecretEnvironmentVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }
        }
      }
    }
  }
}
